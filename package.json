{
  "name": "poker-table",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:types": "tsc -b packages/protocol packages/engine apps/server",
    "typecheck": "npm run build:types && tsc -p apps/web/tsconfig.json && tsc -p tests/tsconfig.json",
    "build": "npm run typecheck && vite build --config apps/web/vite.config.ts",
    "start": "node apps/server/dist/main.js",
    "dev": "npm run build && node --watch apps/server/dist/main.js",
    "test": "npm run build:types && vitest run",
    "test:e2e": "npm run build && playwright test",
    "lint": "eslint apps packages tests scripts *.ts *.js",
    "check": "npm run lint && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@playwright/test": "^1.64.1",
    "@types/node": "22.19.0",
    "eslint": "9.39.4",
    "globals": "17.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.57.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
