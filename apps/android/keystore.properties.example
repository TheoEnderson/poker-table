# Poker Table — Configuração de Assinatura de Release do APK
# ATENÇÃO: NUNCA versione o arquivo real "keystore.properties" nem sua keystore no Git.
#
# Para gerar a sua Release Keystore oficial:
# keytool -genkey -v -keystore poker-table-release.keystore -alias poker-table -keyalg RSA -keysize 2048 -validity 10000
#
# Em seguida, copie este arquivo para apps/android/keystore.properties e preencha:
storeFile=/caminho/seguro/para/poker-table-release.keystore
storePassword=SUA_SENHA_DA_KEYSTORE
keyAlias=poker-table
keyPassword=SUA_SENHA_DA_CHAVE
